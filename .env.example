# Shared
LANGSMITH_API_KEY=
LANGSMITH_PROJECT_PREFIX=voice-demo

# Used by: both OpenAI Realtime backends (raw + Agents SDK), the LLM stage of the
# LiveKit and Pipecat cascades and their OpenAI Realtime variants, and the
# pipecat-with-langgraph brain.
OPENAI_API_KEY=

# Used by: the Pipecat cascade backend — Deepgram STT (Nova) + TTS (Aura).
DEEPGRAM_API_KEY=

# Used by: the LiveKit cascade backend — AssemblyAI STT + Cartesia TTS.
ASSEMBLYAI_API_KEY=
CARTESIA_API_KEY=

# Used by: raw Gemini Live, Google ADK Live, and the Gemini Live framework variants.
GOOGLE_API_KEY=

# LiveKit — console mode doesn't need a real server, but the SDK still
# validates these at startup. Dummy values are fine.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880

ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
NGROK_AUTHTOKEN=
