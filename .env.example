# Shared
LANGSMITH_API_KEY=
LANGSMITH_PROJECT_PREFIX=voice-demo

# Used by: the OpenAI Realtime backend, the LiveKit STT/LLM/TTS stack (and its
# LangGraph brain), AND the Pipecat backend's STT/LLM/TTS (and its LangGraph brain).
OPENAI_API_KEY=

# Google ADK Live backend (Gemini Live API)
GOOGLE_API_KEY=

# LiveKit — console mode doesn't need a real server, but the SDK still
# validates these at startup. Dummy values are fine.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880
